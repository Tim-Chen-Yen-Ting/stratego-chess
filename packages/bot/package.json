{
  "name": "@xiyang/bot",
  "version": "0.1.0",
  "private": true,
  "description": "行軍西洋棋 bot policies and self-play harness — a measuring instrument that plays through the same ViewerState a human gets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "arena": "node dist/index.js"
  },
  "dependencies": {
    "@xiyang/rules": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
